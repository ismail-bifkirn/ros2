<?xml version="1.0"?>
<package format="3">
  <n>my_robot_simulation</n>
  <version>1.0.0</version>
  <description>Simulation Gazebo du robot 4 roues — mondes, launch, config</description>

  <maintainer email="etudiant@university.ma">Votre Nom</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_ros2_control</depend>
  <depend>my_robot_description</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>skid_steering_controller</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
